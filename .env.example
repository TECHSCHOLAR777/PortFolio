# Web3Forms access key for the contact form.
# Public by design: it only authorises posting to this one form.
# Get one at https://web3forms.com (free, no account needed).
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional. Raises the GitHub API rate limit for /api/stats.
# The route caches for an hour, so the unauthenticated limit is already enough.
# Set this in the Vercel dashboard, never commit a real token.
GITHUB_TOKEN=
